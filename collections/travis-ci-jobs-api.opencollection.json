{
  "opencollection": "1.0.0",
  "info": {
    "name": "Travis CI REST API v3 Builds Jobs API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.travis-ci.com/job/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a job"
        },
        {
          "info": {
            "name": "Cancel a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.travis-ci.com/job/:job_id/cancel",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel a job"
        },
        {
          "info": {
            "name": "Restart a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.travis-ci.com/job/:job_id/restart",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Restart a job"
        },
        {
          "info": {
            "name": "Debug a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.travis-ci.com/job/:job_id/debug",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Debug a job"
        }
      ]
    }
  ],
  "bundled": true
}